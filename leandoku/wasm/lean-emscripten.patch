   return print_value(const_cast<tout &>(ios), v, t);
 }
 
+#ifdef LEAN_EMSCRIPTEN
+// A static wasm module has no dlsym; the embedder may supply a table of its
+// native symbols (e.g. module initializers) so imports do not fall back to
+// interpreting code that is already compiled in.
+extern "C" void * lean_emscripten_lookup_symbol(char const * sym) __attribute__((weak));
+#endif
+
 void * lookup_symbol_in_cur_exe(char const * sym) {
-#ifdef LEAN_WINDOWS
+#if defined(LEAN_EMSCRIPTEN)
+    return lean_emscripten_lookup_symbol ? lean_emscripten_lookup_symbol(sym) : nullptr;
+#elif defined(LEAN_WINDOWS)
     std::vector<HMODULE> hmods(128);
     DWORD bytes_needed;
     lean_always_assert(EnumProcessModules(GetCurrentProcess(), &hmods[0], hmods.size() * sizeof(HMODULE), &bytes_needed));
diff --git a/src/runtime/object.cpp b/src/runtime/object.cpp
index 8e068ec..62d3445 100644
--- a/src/runtime/object.cpp
+++ b/src/runtime/object.cpp
@@ -703,8 +703,12 @@ class task_manager {
             return;
         }
         if (prio > LEAN_MAX_PRIO) {
+#ifdef LEAN_MULTI_THREAD
             spawn_dedicated_worker(t);
             return;
+#else
+            prio = LEAN_MAX_PRIO;
+#endif
         }
         if (prio > m_max_prio)
             m_max_prio = prio;
@@ -909,6 +913,16 @@ public:
         if (t->m_value)
             return;
         unique_lock<mutex> lock(m_mutex);
+#ifndef LEAN_MULTI_THREAD
+        // Single-threaded: there are no workers, so run queued tasks here
+        // until the one we need has a value.
+        while (!t->m_value) {
+            if (m_queues_size == 0)
+                lean_internal_panic("Task.get: the task can never finish (single-threaded runtime, nothing left to run)");
+            run_task(lock, dequeue());
+        }
+        return;
+#endif
         if (t->m_value)
             return;
         // see `Task.get`
@@ -929,6 +943,13 @@ public:
         }
     }
 
+    /* Single-threaded runtime: run every queued task. */
+    void run_pending() {
+        unique_lock<mutex> lock(m_mutex);
+        while (m_queues_size != 0)
+            run_task(lock, dequeue());
+    }
+
     void deactivate_task(lean_task_object * t) {
         unique_lock<mutex> lock(m_mutex);
         if (object * v = t->m_value) {
@@ -975,9 +996,18 @@ extern "C" LEAN_EXPORT void lean_init_task_manager_using(unsigned num_workers) {
     if (num_workers > 0) {
         g_task_manager = new task_manager(num_workers);
     }
+#else
+    // No workers: tasks are queued and run by `Task.get` or `lean_run_pending_tasks`.
+    // Promises need a task manager, so single-threaded builds get one too.
+    (void)num_workers;
+    g_task_manager = new task_manager(0);
 #endif
 }
 
+extern "C" LEAN_EXPORT void lean_run_pending_tasks() {
+    if (g_task_manager) g_task_manager->run_pending();
+}
